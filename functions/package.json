  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/vision": "^6.0.0",
    "@google/generative-ai": "^0.24.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "firebase-functions-test": "^3.4.1",
    "typescript": "^6.0.0",
    "vitest": "^2.1.5"
  },
  "private": true
}
